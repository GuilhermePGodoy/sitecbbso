# Copie este arquivo para ".env" e preencha com seus valores reais.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

# Banco de Dados (PostgreSQL)
DB_NAME=cbbso
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_HOST=localhost
DB_PORT=5432

# Servidor
PORT=3000
NODE_ENV=development

# Front-end (usado pelo CORS)
FRONTEND_URL=http://localhost:5173

# Autenticação (JWT) — troque por um valor aleatório
AUTH_SECRET=
